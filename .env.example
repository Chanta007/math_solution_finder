# Math Solution Finder — Environment Variables
# Copy to .env and fill in your values: cp .env.example .env

# Required
ANTHROPIC_API_KEY=<your-anthropic-api-key>

# Optional (defaults shown)
# MATH_SOLVER_LOG_LEVEL=INFO
# MATH_SOLVER_MAX_ITERATIONS=10
# MATH_SOLVER_CONVERGENCE_DIR=docs/convergence
# MATH_SOLVER_MODEL=claude-sonnet-4-5-20250514
# MATH_SOLVER_MAX_TOKENS=4096
# MATH_SOLVER_TEMPERATURE=0.7
